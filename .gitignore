# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv/

# Jupyter & Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# macOS artifacts
.DS_Store
.AppleDouble
.LSOverride
._*

# Large data files (Raw CSV files are large, keep them local)
train.csv
test.csv
data/raw/
!data/sample_*.csv

# MoE datasets (reproducible via Hub: moe/download_small_text.py)
# Keep local only — 126 MB total.
data/moe/*.csv

# Model weights & large binaries
# NOTE: baseline top-level pkls are legacy-tracked; MoE models ARE tracked
# (models/moe/*.pkl, ~5 MB) so the repo runs without retraining.
# The '*' patterns below only match the top level, NOT models/moe/ subdir.
models/*.pt
models/*.bin
models/*.safetensors
models/*.pkl
models/*.joblib

# Report backups (merged PDF is canonical)
*.pre-moe.pdf
!reports/*.pdf

# MoE data zip (131 MB uncompressed CSVs) — local only, via Drive / moe/download_small_text.py
data/ai_text_moe_data.zip

# Vercel web deploy (web/)
# .vercel = local tokens/state — never push
web/.vercel/
web/.venv/
web/.python-version
# Duplicated deploy copies (regenerate via cp, see web/README.md):
web/api/models/
web/api/figures/
web/api/reports/
web/api/index.html

# Logs and run files
*.log
.coverage
htmlcov/

# Inference outputs (regenerable)
test/results/
test/results_svm/
api.log
streamlit.log
results/example_test_set.csv
test/example_test_set.csv
